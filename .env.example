# ── Supabase (server-side only — never expose the service-role key to the browser)
# Project Settings → API. The anon key is no longer used.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── OpenAI (the only AI provider)
OPENAI_API_KEY=sk-...
# Writes questions and arena challenges. Needs Structured Outputs support.
OPENAI_MODEL=gpt-5
# Grades answers and repairs explanations. Cheaper and faster.
OPENAI_FAST_MODEL=gpt-5-mini
# Vector memory for de-duplication. Must produce 1536-dim vectors (matches db/schema.sql).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Single-user sign-in
# The one password that unlocks the app.
APP_PASSWORD=choose-a-long-passphrase
# Signs the session cookie. At least 32 random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=

# ── When "today" rolls over (IANA zone, e.g. Asia/Kolkata, Europe/London)
APP_TIMEZONE=UTC
